{
  "manifest_version": 3,
  "name": "VoidUI — Nothing & Caelestia Startpage",
  "short_name": "VoidUI",
  "version": "1.0.0",
  "description": "Futuristic new tab startpage combining Nothing OS dot matrix aesthetics, OneUI widgets, and CachyOS Hyprland Caelestia shell.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "topSites"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "https://duckduckgo.com/*",
    "https://suggestqueries.google.com/*",
    "https://search.brave.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://ipwho.is/*",
    "https://freeipapi.com/*",
    "https://api.openweathermap.org/*",
    "https://hacker-news.firebaseio.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "voidui@extension.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "favicon/icon-16.png",
    "32": "favicon/icon-32.png",
    "48": "favicon/icon-48.png",
    "128": "favicon/icon-128.png"
  }
}
